		sourceColumn: price

		annotation SummarizationSetBy = Automatic

	column freight_value
		dataType: double
		formatString: #,0.00
		lineageTag: fc53f315-2fcb-4aeb-b750-13fa0c30245d
		summarizeBy: sum
		sourceColumn: freight_value

		annotation SummarizationSetBy = Automatic

	partition fct_order_items = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(MartsFolder & "\fct_order_items.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table


		dataType: double
		formatString: #,0.00
		lineageTag: fca60efc-3eaf-4bb5-8367-bec2e2a4006c
		summarizeBy: sum
		sourceColumn: hours_to_approve

		annotation SummarizationSetBy = Automatic

	column days_to_deliver
		dataType: double
		formatString: #,0.00
		lineageTag: 73a838e1-e384-47aa-a403-efa1e0c97a3d
		summarizeBy: sum
		sourceColumn: days_to_deliver

		annotation SummarizationSetBy = Automatic

	column days_late_vs_estimate
		dataType: int64
		formatString: 0
		lineageTag: 61ddaeda-6f5a-4a6b-a818-4edb08abc1f9
		summarizeBy: none
		sourceColumn: days_late_vs_estimate

	column is_delivered
		dataType: boolean
		lineageTag: fc99041b-8a39-47cb-b17b-31e7f473ce6d
		summarizeBy: none
		sourceColumn: is_delivered

	column is_late
		dataType: boolean
		lineageTag: ed8d3d54-1e33-4aba-95ff-45fb0f3c526a
		summarizeBy: none
		sourceColumn: is_late

	/// Same bands as dbt/analyses/09_review_score_vs_delay.sql. Blank when the order was not delivered.
	column delay_bucket =
			SWITCH(
			    TRUE(),
			    NOT fct_orders[is_delivered], BLANK(),
			    fct_orders[days_late_vs_estimate] <= 0, "1. no prazo ou antes",
			    fct_orders[days_late_vs_estimate] <= 3, "2. 1 a 3 dias de atraso",
			    fct_orders[days_late_vs_estimate] <= 7, "3. 4 a 7 dias de atraso",
			    fct_orders[days_late_vs_estimate] <= 14, "4. 8 a 14 dias de atraso",
			    "5. mais de 14 dias de atraso"
			)
		dataType: string
		lineageTag: 4b2774f2-03c2-4533-98a8-bb45cd0323bb
		summarizeBy: none

	/// Distinct sellers in the order. A review or a delay is only attributed to a seller when this is 1 (same rule as analysis 08).
	column sellers_count = CALCULATE(DISTINCTCOUNT(fct_order_items[seller_key]))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 02131055-bf6c-4426-9923-b421fef49ea2
		summarizeBy: none

	/// Average review score of the order, computed once at refresh. An order with several reviews counts once (analyses 08 and 09).
	column order_score = CALCULATE(AVERAGE(fct_reviews[review_score]))
		dataType: double
		formatString: 0.00
		lineageTag: 99da3269-4920-45d6-910b-ef9394de6126
		summarizeBy: none

	/// The seller of orders with a single seller; blank otherwise. Inactive relationship to dim_seller, used only by the seller measures.
	column single_seller_key = IF(fct_orders[sellers_count] = 1, CALCULATE(MAX(fct_order_items[seller_key])))
		dataType: string
		isHidden
		lineageTag: 066befd3-4070-407c-a164-d6016e5b9830
		summarizeBy: none

	partition fct_orders = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(MartsFolder & "\fct_orders.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table


		summarizeBy: none
		sourceColumn: delivered_to_customer_date_key

	column estimated_delivery_date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dabbbd0c-bff9-4fe8-92c6-d75587d5581f
		summarizeBy: none
		sourceColumn: estimated_delivery_date_key

	column order_status
		dataType: string
		lineageTag: 91616fb8-5f22-483f-8e37-470460cbb7ee

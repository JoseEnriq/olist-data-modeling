/// Accumulating snapshot, one row per order. Works as the order header: items, payments and reviews connect to it by order_id.
table fct_orders
	lineageTag: ec1593c2-c8f6-43b8-8ac4-3d5d0e51fde4

	column order_id
		dataType: string
		lineageTag: 5425029f-cc6e-43ac-9d34-eeda5c8e515d
		summarizeBy: none
		sourceColumn: order_id

	column customer_key
		dataType: string
		isHidden

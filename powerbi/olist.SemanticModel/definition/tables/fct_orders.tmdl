		summarizeBy: none
		sourceColumn: delivered_to_carrier_at

	column delivered_to_customer_at
		dataType: dateTime
		formatString: dd/MM/yyyy HH:mm
		lineageTag: 94d06598-5efb-42b0-bfff-e916901dcd56
		summarizeBy: none
		sourceColumn: delivered_to_customer_at

	column estimated_delivery_date
		dataType: dateTime
